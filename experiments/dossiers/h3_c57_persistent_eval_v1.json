    "flattened_history_feature",
    "commit_planned_actions",
    "commit_partial_terminal_tail",
    "intermediate_checkpoint_promotion",
    "unpaired_D0_seed_or_sample"
  ],
  "gpu_policy": "do_not_interrupt_n1_long_train; evaluate_on_idle_node"
}
