{
  "candidate": "C57",
  "classification": "action-only-on-frozen-h3-kv",
  "method": "lingbot_persistent_observation_action_kv",
  "evaluation_schema": "c57_heldout_eval_plan_v1",
  "checkpoint_schedule": {
    "start": 200,
    "stop": 5000,
    "interval": 200,
    "promotion_checkpoint": 5000
  },
  "control": "D0_frozen_source_checkpoint",
  "paired_contract": [
    "current_id",
    "heldout_episode",
    "flow_seed",
